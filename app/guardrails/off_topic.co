define bot refuse off topic
  "I am happy to help with your insurance claim, but I cannot cover that topic. If you have a question about your identity check or your claim, I can take that. If you would rather speak with a person, I can connect you with a human representative."

define user ask weather
  "what's the weather today"
  "what is the weather today"
  "how's the weather"
  "how is the weather"
  "is it raining"
  "is it going to snow"
  "what's the temperature outside"
  "give me a weather forecast"

define user ask trivia
  "what is RL"
  "what is reinforcement learning"
  "tell me a joke"
  "who won the game"
  "write me some python code"
  "what's 2 + 2"
  "recommend a movie"
  "what's the capital of France"
  "what should I cook for dinner"
  "who is the president"
  "play a song"
  "how do I invest in stocks"
  "translate this to spanish"
  "what time is it right now"
  "do you know what time it is"

define flow check off topic
  $off_topic = execute check_off_topic
  if $off_topic
    bot refuse off topic
    stop
