GROQ_API_KEY=

# Logfire (https://logfire.pydantic.dev)
# Local: `poetry run logfire auth` then `poetry run logfire projects use <project-name>`
# Production: paste a write token from the Logfire project settings.
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=sop-claims-agent
LOGFIRE_CONSOLE=true

# Llama Prompt Guard 2 on Groq (same GROQ_API_KEY as the chat models)
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_FALLBACK_MODEL=meta-llama/llama-prompt-guard-2-22m
PROMPT_GUARD_THRESHOLD=0.5

# Dummy claims-support mailbox used by POST_PROCESS (writes .eml files under app/DATA/outbox)
DUMMY_EMAIL_FROM=claims-support@example.com

# FastAPI backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

